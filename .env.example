# Viešas svetainės adresas – canonical, sitemap, robots ir OpenGraph nuorodos.
NEXT_PUBLIC_SITE_URL=https://gloumi.lt

# Parduotuvių nuorodos. Kol tuščios, ženkleliai rodo „Netrukus“ ir niekur neveda.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=

# Meistrų užklausų forma (/api/waitlist) – bent VIENAS iš dviejų kanalų.
# 1) Webhook: užklausa POST'inama kaip JSON (Slack, Zapier, Make, Supabase Edge Function…).
WAITLIST_WEBHOOK_URL=
# 2) El. paštas per Resend (https://resend.com) – laiškas ateina į WAITLIST_TO_EMAIL.
RESEND_API_KEY=
WAITLIST_TO_EMAIL=info@gloumi.lt
WAITLIST_FROM_EMAIL=Gloumi <no-reply@gloumi.lt>
