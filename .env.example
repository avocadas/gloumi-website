# Viešas svetainės adresas – canonical, sitemap, robots ir OpenGraph nuorodos.
NEXT_PUBLIC_SITE_URL=https://gloumi.lt

# Parduotuvių nuorodos. Kol tuščios, ženkleliai rodo „Netrukus“ ir niekur neveda.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=

# Meistrų užklausų forma (/api/waitlist) – bent VIENAS iš dviejų kanalų.
# 1) Webhook: užklausa POST'inama kaip JSON (Slack, Zapier, Make, Supabase Edge Function…).
WAITLIST_WEBHOOK_URL=
# 2) El. paštas per Resend (https://resend.com).
#    SIUNTĖJAS PRIVALO BŪTI @mail.gloumi.lt – Resend patvirtintas būtent tas
#    subdomenas (DKIM resend._domainkey.mail, grįžtamasis kelias send.mail).
#    Adresas ant gryno gloumi.lt bus atmestas arba nukris į šiukšles.
RESEND_API_KEY=
WAITLIST_TO_EMAIL=info@gloumi.lt
WAITLIST_FROM_EMAIL=Gloumi <no-reply@mail.gloumi.lt>

# --- Administravimo portalas (/admin) ---
#
# Be šių trijų reikšmių /admin neveiks, o visa likusi svetainė veiks kaip
# veikusi: middleware dirba tik ties /admin.
#
# Pirmos dvi yra VIEŠOS ir tokios pat, kaip programėlėje
# (gloumi-app/src/config/supabase.js) - jos keliauja į naršyklę pagal
# apibrėžimą, ir tai nėra nutekėjimas.
NEXT_PUBLIC_SUPABASE_URL=https://opcvzdejoitxhpgvblll.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# TREČIOJI YRA TIKRA PASLAPTIS. Ji apeina RLS ir mato viską, įskaitant
# kiekvieno žmogaus žinutes ir privačius užrašus. Niekada nededama į git'ą,
# niekada neprasideda NEXT_PUBLIC_, ir gyvena tik .env.local bei Vercel
# aplinkos kintamuosiuose. `src/lib/supabase/admin.ts` pirma eilutė yra
# `import 'server-only'` būtent todėl: netyčinis importas iš kliento
# komponento taptų build'o klaida, o ne tyliu raktu naršyklėje.
SUPABASE_SERVICE_ROLE_KEY=

# --- Laiškas apie naują pranešimą apie turinį (/api/hooks/new-report, Gloumi #170) ---
#
# Duomenų bazės trigeris kviečia maršrutą su šia paslaptimi antraštėje
# x-gloumi-hook-secret; ta pati reikšmė saugoma Supabase Vault. Be jos maršrutas
# atsako 503, su neteisinga – 401. Paslaptis: niekada NEXT_PUBLIC_, niekada į
# git'ą; Vercel'yje – tik Production ir Sensitive.
REPORT_HOOK_SECRET=
# Kam siųsti laišką; tuščia – info@gloumi.lt. Siunčiama per Resend (RESEND_API_KEY),
# laiške tik priežastis ir nuoroda į /admin – be turinio ir vardų.
MODERATION_ALERT_TO=

# --- Laiškai iš bazės eilės notification_emails (Gloumi P2B 4 str., skolų pranešimai) ---
# Vercel cron (vercel.json, kas 10 min.) kviečia /api/cron/notification-emails su
# Authorization: Bearer <CRON_SECRET>. Be jos maršrutas atsako 503 ir eilės neliečia,
# su neteisinga – 401. Siunčiama per RESEND_API_KEY. Vercel'yje – tik Production, Sensitive.
CRON_SECRET=
